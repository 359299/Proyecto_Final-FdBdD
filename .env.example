# Configuración de Conexión a Oracle Database
# Modifica estos valores con las credenciales de tu Oracle Database / SQL Developer
DB_USER=SYSTEM
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=XEPDB1
# O bien DB_SID=XE si tu versión de Oracle utiliza SID en lugar de Service Name
